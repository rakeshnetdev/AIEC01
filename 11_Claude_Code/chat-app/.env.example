# Anthropic API key (programmatic SDK use is billed via the API).
# Omit it if the machine is already authenticated with the Claude Code CLI.
ANTHROPIC_API_KEY=sk-ant-...

# Absolute path of the repository the concierge answers questions about.
# Defaults to the repo root above this session directory.
TARGET_REPO=/absolute/path/to/some/repo

# Optional: model + hard cap on agent loop iterations per message.
CONCIERGE_MODEL=claude-sonnet-5
CONCIERGE_MAX_TURNS=25
